{{!< default}}

<section class="article" style="padding-top:5rem;">
    <div class="container">
        <header class="article-header">
            {{#if profile_image}}
                <div style="text-align:center; margin-bottom:1.5rem;">
                    <img src="{{profile_image}}" alt="{{name}}" style="width:100px; height:100px; border-radius:50%; object-fit:cover; margin:0 auto; box-shadow:var(--shadow-md);">
                </div>
            {{/if}}
            <h1 class="article-title">{{name}}</h1>
            {{#if bio}}
                <p class="article-excerpt">{{bio}}</p>
            {{/if}}
        </header>

        <div class="post-grid" style="margin-top:2rem;">
            {{#foreach posts}}
            <article class="post-card">
                <a href="{{url}}">
                    {{#if feature_image}}
                        <img src="{{feature_image}}" alt="{{title}}" loading="lazy">
                    {{/if}}
                    <h3>{{title}}</h3>
                    <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                </a>
            </article>
            {{/foreach}}
        </div>
    </div>
</section>
