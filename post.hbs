{{!< default}}

{{#post}}
<article class="article">
    <div class="container">
        <header class="article-header">
            <div class="post-card-tags" style="justify-content:center; margin-bottom:0.8rem;">
                {{#primary_tag}}
                    <span class="post-card-primary-tag">
                        <a href="{{url}}">{{name}}</a>
                    </span>
                {{/primary_tag}}
                {{#if featured}}
                    <span class="post-card-featured">
                        {{> "icons/fire"}}
                        Featured
                    </span>
                {{/if}}
            </div>

            <h1 class="article-title">{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="article-excerpt">{{custom_excerpt}}</p>
            {{/if}}

            <div class="article-byline">
                <div class="article-byline-content">
                    <ul class="author-list">
                        {{#foreach authors}}
                        <li class="author-list-item">
                            <div class="author-avatar">
                                {{#if profile_image}}
                                    <img class="author-profile-image" src="{{profile_image}}" alt="{{name}}" />
                                {{else}}
                                    {{> "icons/avatar"}}
                                {{/if}}
                            </div>
                        </li>
                        {{/foreach}}
                    </ul>
                    <div class="article-byline-meta">
                        <h4 class="author-name">
                            {{#foreach authors}}{{name}}{{#unless @last}}, {{/unless}}{{/foreach}}
                        </h4>
                        <div class="byline-meta-content">
                            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                            <span class="byline-reading-time">
                                <span class="bull">&bull;</span> {{reading_time}}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        {{#if feature_image}}
            <figure class="article-image">
                <img src="{{feature_image}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
                {{#if feature_image_caption}}
                    <figcaption>{{feature_image_caption}}</figcaption>
                {{/if}}
            </figure>
        {{/if}}

        <div class="gh-content">
            {{content}}
        </div>
    </div>
</article>

{{!-- Read more links, just above the footer --}}
{{!-- Fetches the latest 3 posts, excluding the current one --}}
{{#get "posts" filter="id:-{{id}}+tag:-[gallery,faculty,ex-faculty]" limit="3" as |more_posts|}}

    {{#if more_posts}}
        <section class="read-more-section section">
            <div class="container">
                <div class="section-header">
                    <span class="eyebrow">{{> "icons/book"}} Keep Reading</span>
                    <h2>Latest Posts</h2>
                    <p>Explore more articles from Sankalp Learning</p>
                </div>
                <div class="post-grid">
                    {{#foreach more_posts}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>
            </div>
        </section>
    {{/if}}

{{/get}}

{{/post}}
